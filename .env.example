POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
POLYMARKET_USER_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/user
POLYMARKET_EVENT_SLUG=highest-temperature-in-nyc-on-april-16-2026
FORECAST_TARGET_DATE=2026-04-16
FORECAST_SOURCE=gfs
FORECAST_LATITUDE=40.7769
FORECAST_LONGITUDE=-73.8740
FORECAST_TIMEZONE=America/New_York
GFS_FORECAST_URL=https://api.open-meteo.com/v1/gfs
PRICE_MIN=0.90
PRICE_MAX=0.99
DISTANCE_THRESHOLD_F=4
ORDER_SIZE_USD=5
ORDERBOOK_SYNC_SECONDS=8
MAX_BOOK_STALENESS_SECONDS=30
DRY_RUN=true
MONITOR_MODE=false
POLL_INTERVAL_SECONDS=60
LOG_DIRECTORY=/tmp/polymarket-weather-bot
STORAGE_PATH=/tmp/polymarket-weather-bot/runs.jsonl

# Required for live order submission when DRY_RUN=false.
POLYMARKET_PRIVATE_KEY=
